{
  "name": "document-translator-server",
  "version": "1.0.0",
  "description": "Document translation server with layout preservation for PDF, DOCX, and PPTX",
  "main": "index.js",
  "bin": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "test": "jest --runInBand --detectOpenHandles",
    "build:exe": "pkg . --targets node18-win-x64 --output ./release/DocumentAssistant.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "routes/**/*",
      "services/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "./release"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.10.1",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "node-edge-tts": "^1.2.10",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.19.1",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "supertest": "^7.0.0"
  }
}
